{
  "name": "@axiom/science-eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures.ts"
  },
  "bin": {
    "axiom-science-eval": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "eval": "tsx src/cli.ts",
    "lint": "eslint src",
